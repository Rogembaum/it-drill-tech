# State may contain passwords and secret keys in plain text.
*.tfstate
*.tfstate.*
.terraform/

# Local variable files may contain credentials.
*.tfvars
*.tfvars.json
backend.hcl

# Local Terraform overrides and crash logs.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log

# Keep .terraform.lock.hcl tracked to pin provider versions.
